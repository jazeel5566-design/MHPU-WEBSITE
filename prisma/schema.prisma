// MHPU platform data model (PostgreSQL — Supabase in production).
//  DATABASE_URL: pooled connection used by the app (Supabase "transaction" pooler, port 6543)
//  DIRECT_URL:   direct connection used by `prisma db push` / migrations
// Status/role fields are strings; allowed values are listed in src/lib/constants.ts.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── People & access ────────────────────────────────────────────────

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String
  passwordHash String
  role         String    @default("MEMBER") // ADMIN | EDITOR | AUTHOR | CASEWORKER | MEMBER
  title        String? // position shown when logged in, e.g. "President", "General Secretary" (ExCom)
  active       Boolean   @default(true)
  lastLoginAt  DateTime?
  sessionVersion Int     @default(0) // bump to sign out all of this user's sessions
  createdAt    DateTime  @default(now())

  member        Member?
  posts         Post[]        @relation("PostAuthor")
  reviewedPosts Post[]        @relation("PostReviewer")
  assignedCases Case[]        @relation("CaseAssignee")
  caseMessages  CaseMessage[]
  auditLogs     AuditLog[]
  media         Media[]
}

model Affiliate {
  id          String   @id @default(cuid())
  name        String
  nameDv      String?
  shortName   String
  description String?
  memberCount Int      @default(0)
  website     String?
  workplace   String? // workplaces shown publicly, comma-separated, e.g. "IGMH, Dharumavantha Hospital"
  matchNames  String? // other spellings/abbreviations used only for matching applicants (not shown)
  active      Boolean  @default(true) // listed on the membership form
  nextMemberNo Int     @default(1) // next union membership number to hand out (shortName-0001, …); never reused
  createdAt   DateTime @default(now())

  members      Member[]
  applications Application[]
  elections    Election[]
}

model Member {
  id             String    @id @default(cuid())
  membershipNo   String    @unique
  fullName       String
  idNumber       String // National ID card or passport/work-permit number
  nationality    String    @default("Maldivian")
  address        String?
  phone          String
  email          String
  dateOfBirth    DateTime?
  gender         String?
  profession     String // Nurse, Doctor, Allied Health, …
  role           String? // job title
  employer       String // facility name
  atoll          String
  island         String?
  status         String    @default("ACTIVE") // ACTIVE | INACTIVE (dues not paid yet, not activated) | LAPSED | SUSPENDED | RESIGNED
  joinedAt       DateTime  @default(now())
  duesPaidUntil  DateTime?
  isRep          Boolean   @default(false) // workplace representative
  autopay          Boolean   @default(false) // automatic dues payment switched on by the member
  autopayMonths    Int       @default(1) // months paid per automatic payment
  autopayToken     String? // saved-card token from the payment gateway (never the card number)
  autopayCardLabel String? // e.g. "Visa •••• 4242" for display
  autopayConsentAt DateTime?
  notes          String?
  needsReview    Boolean   @default(false) // details missing or possibly duplicated — a staff member checks and corrects them
  reviewNote     String? // what to check
  unionMemberNo  String? // number issued by the workplace union, e.g. IGMH-SU-0001 (a new one whenever the union changes)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  userId      String?    @unique
  user        User?      @relation(fields: [userId], references: [id])
  affiliateId String?
  affiliate   Affiliate? @relation(fields: [affiliateId], references: [id])

  cases      Case[]
  payments   Payment[]
  rsvps      EventRsvp[]
  ballotVoters BallotVoter[]
  paymentIntents PaymentIntent[]
  candidacies    ElectionCandidate[]
  electionVoters ElectionVoter[]
  attendances    EventAttendance[]
  smsMessages    SmsMessage[]

  @@unique([affiliateId, unionMemberNo])
}

model Application {
  id              String    @id @default(cuid())
  reference       String    @unique // shown to the applicant, e.g. APP-2026-0007
  fullName        String
  address         String // present address
  country         String    @default("Maldives")
  idNumber        String // National ID or passport number
  phone           String
  email           String
  jobTitle        String
  employer        String // hospital / company
  profession      String?
  atoll           String?
  island          String?
  category        String? // segment chosen on the join page
  affiliateId     String? // workplace union chosen on the form
  affiliate       Affiliate? @relation(fields: [affiliateId], references: [id], onDelete: SetNull)
  referredBy      String?
  idDocFile       String? // private file: copy of ID / passport
  signatureFile   String? // private file: drawn signature (PNG)
  declarationDate DateTime?
  consent         Boolean   @default(false)
  status          String    @default("PENDING") // PENDING | APPROVED | REJECTED
  reviewNote      String?
  receivedBy      String? // name of the officer who processed it (office use)
  reviewedAt      DateTime? // processed date (office use)
  memberId        String? // member record created on approval
  createdAt       DateTime  @default(now())
}

// ─── Content ────────────────────────────────────────────────────────

model Post {
  id          String    @id @default(cuid())
  title       String
  titleDv     String?
  slug        String    @unique
  excerpt     String?
  excerptDv   String?
  body        String // Markdown
  bodyDv      String?
  coverImage  String?
  category    String    @default("NEWS") // NEWS | PRESS_RELEASE | STATEMENT | NOTICE | FEATURE
  tags        String? // comma-separated
  status      String    @default("DRAFT") // DRAFT | IN_REVIEW | SCHEDULED | PUBLISHED | ARCHIVED
  visibility  String    @default("PUBLIC") // PUBLIC | MEMBERS
  featured    Boolean   @default(false)
  publishAt   DateTime?
  publishedAt DateTime?
  reviewNote  String?
  views       Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  authorId   String
  author     User    @relation("PostAuthor", fields: [authorId], references: [id])
  reviewerId String?
  reviewer   User?   @relation("PostReviewer", fields: [reviewerId], references: [id])
}

model Campaign {
  id          String   @id @default(cuid())
  title       String
  titleDv     String?
  slug        String   @unique
  summary     String
  summaryDv   String?
  body        String
  coverImage  String?
  status      String   @default("ACTIVE") // DRAFT | ACTIVE | WON | CLOSED
  goal        Int      @default(1000) // petition signature goal
  hasPetition Boolean  @default(true)
  petitionAsk String? // the demand people sign
  featured    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  signatures PetitionSignature[]
}

model PetitionSignature {
  id         String   @id @default(cuid())
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  name       String
  email      String
  atoll      String?
  isHealthWorker Boolean @default(false)
  createdAt  DateTime @default(now())

  @@unique([campaignId, email])
}

model Event {
  id          String   @id @default(cuid())
  title       String
  titleDv     String?
  description String
  startsAt    DateTime
  endsAt      DateTime?
  location    String
  isOnline    Boolean  @default(false)
  type        String   @default("MEETING") // MEETING | TRAINING | CPD | RALLY | AGM | WEBINAR
  visibility  String   @default("PUBLIC") // PUBLIC | MEMBERS
  capacity    Int?
  cpdHours    Float?
  published   Boolean  @default(true)
  meetingUrl  String? // e.g. Google Meet link; only shown to signed-in members
  createdAt   DateTime @default(now())

  rsvps       EventRsvp[]
  attendances EventAttendance[]
}

/** Who clicked "Join meeting" (online attendance record). */
model EventAttendance {
  id       String   @id @default(cuid())
  eventId  String
  event    Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  memberId String
  member   Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  joinedAt DateTime @default(now())

  @@unique([eventId, memberId])
}

model EventRsvp {
  id        String   @id @default(cuid())
  eventId   String
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  memberId  String
  member    Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([eventId, memberId])
}

model Resource {
  id          String   @id @default(cuid())
  title       String
  titleDv     String?
  description String?
  category    String // AGREEMENT | POLICY | FORM | REPORT | GUIDE | CONSTITUTION
  visibility  String   @default("PUBLIC") // PUBLIC | MEMBERS
  fileUrl     String
  fileSize    Int?
  downloads   Int      @default(0)
  createdAt   DateTime @default(now())
}

model Media {
  id         String   @id @default(cuid())
  url        String
  filename   String
  mimeType   String
  size       Int
  alt        String?
  uploadedById String?
  uploadedBy User?    @relation(fields: [uploadedById], references: [id])
  createdAt  DateTime @default(now())
}

// ─── Member services ────────────────────────────────────────────────

model Case {
  id          String    @id @default(cuid())
  reference   String    @unique
  memberId    String
  member      Member    @relation(fields: [memberId], references: [id], onDelete: Cascade)
  type        String // PAY_OVERTIME | WORKING_HOURS | SAFETY | DISCIPLINARY | CONTRACT | VISA_PERMIT | HARASSMENT | OTHER
  subject     String
  description String
  facility    String?
  urgency     String    @default("NORMAL") // LOW | NORMAL | HIGH | URGENT
  status      String    @default("OPEN") // OPEN | IN_PROGRESS | AWAITING_MEMBER | RESOLVED | CLOSED
  assigneeId  String?
  assignee    User?     @relation("CaseAssignee", fields: [assigneeId], references: [id])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  closedAt    DateTime?

  messages CaseMessage[]
}

model CaseMessage {
  id         String   @id @default(cuid())
  caseId     String
  case       Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)
  authorId   String
  author     User     @relation(fields: [authorId], references: [id])
  body       String
  internal   Boolean  @default(false) // staff-only note
  createdAt  DateTime @default(now())
}

model Payment {
  id        String   @id @default(cuid())
  memberId  String
  member    Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  amount    Float // MVR
  period    String // e.g. "2026-11" or "2026"
  method    String   @default("SALARY_DEDUCTION") // SALARY_DEDUCTION | BANK_TRANSFER | CASH | CARD
  reference String?
  paidAt    DateTime @default(now())
}

model Ballot {
  id          String    @id @default(cuid())
  title       String
  question    String
  description String?
  opensAt     DateTime
  closesAt    DateTime
  anonymous   Boolean   @default(true)
  createdAt   DateTime  @default(now())

  options BallotOption[]
  votes   Vote[]
  voters  BallotVoter[]
}

model BallotOption {
  id       String @id @default(cuid())
  ballotId String
  ballot   Ballot @relation(fields: [ballotId], references: [id], onDelete: Cascade)
  label    String
  order    Int    @default(0)
  votes    Vote[]
}

// A counted choice. Deliberately holds NO member and NO time, so it can't be linked to a voter.
model Vote {
  id       String       @id @default(uuid())
  ballotId String
  ballot   Ballot       @relation(fields: [ballotId], references: [id], onDelete: Cascade)
  optionId String
  option   BallotOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
}

// Who has voted (one per member per ballot) — never what they chose.
model BallotVoter {
  id       String   @id @default(uuid())
  ballotId String
  ballot   Ballot   @relation(fields: [ballotId], references: [id], onDelete: Cascade)
  memberId String
  member   Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  votedAt  DateTime @default(now())

  @@unique([ballotId, memberId])
}

// A vote waiting to be counted, encrypted. Counted in shuffled batches (see src/lib/ballots.ts).
model BallotPendingVote {
  id       String @id @default(uuid())
  ballotId String
  sealed   String
}

// ─── Site operations ────────────────────────────────────────────────

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  topic     String
  message   String
  handled   Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Subscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
}

model Setting {
  key   String @id
  value String
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  action    String
  entity    String
  entityId  String?
  detail    String?
  createdAt DateTime @default(now())
}

// ─── Workplace union elections (secret ballot) ──────────────────────
// ElectionVoter records WHO voted; ElectionVote records WHAT was chosen.
// The two are never linked (random UUIDs, no timestamps on votes), so a
// ballot cannot be traced back to a member.

model Election {
  id               String    @id @default(cuid())
  title            String
  description      String?
  affiliateId      String? // workplace union; null = all MHPU members
  affiliate        Affiliate? @relation(fields: [affiliateId], references: [id], onDelete: Restrict)
  opensAt          DateTime
  closesAt         DateTime
  requireDuesPaid  Boolean   @default(true) // only members with dues up to date may vote
  resultsPublished Boolean   @default(false)
  createdAt        DateTime  @default(now())

  positions ElectionPosition[]
  voters    ElectionVoter[]
}

model ElectionPosition {
  id         String   @id @default(cuid())
  electionId String
  election   Election @relation(fields: [electionId], references: [id], onDelete: Cascade)
  title      String // e.g. President
  seats      Int      @default(1) // how many people are elected to this position
  order      Int      @default(0)

  candidates ElectionCandidate[]
  votes      ElectionVote[]
}

model ElectionCandidate {
  id         String           @id @default(cuid())
  positionId String
  position   ElectionPosition @relation(fields: [positionId], references: [id], onDelete: Cascade)
  memberId   String
  member     Member           @relation(fields: [memberId], references: [id], onDelete: Cascade)
  statement  String?

  votes ElectionVote[]

  @@unique([positionId, memberId])
}

model ElectionVoter {
  id         String   @id @default(uuid())
  electionId String
  election   Election @relation(fields: [electionId], references: [id], onDelete: Cascade)
  memberId   String
  member     Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  votedAt    DateTime @default(now())

  @@unique([electionId, memberId])
}

model ElectionVote {
  id          String            @id @default(uuid())
  positionId  String
  position    ElectionPosition  @relation(fields: [positionId], references: [id], onDelete: Cascade)
  candidateId String
  candidate   ElectionCandidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
}

// ─── Online dues payments ───────────────────────────────────────────

model PaymentIntent {
  id          String    @id @default(uuid())
  memberId    String
  member      Member    @relation(fields: [memberId], references: [id], onDelete: Cascade)
  months      Int
  amount      Float // MVR
  provider    String // BML | TEST
  auto        Boolean   @default(false) // created by auto-pay (charged or sent as a pay link)
  providerRef String? // gateway transaction id
  status      String    @default("PENDING") // PENDING | PAID | FAILED | CANCELLED | EXPIRED
  paymentId   String? // Payment created when confirmed
  createdAt   DateTime  @default(now())
  paidAt      DateTime?
}

// ─── SMS ────────────────────────────────────────────────────────────

model SmsMessage {
  id          String   @id @default(cuid())
  to          String // normalised, e.g. 9607771234
  body        String
  kind        String   @default("MANUAL") // MANUAL | DUES_UPCOMING | DUES_OVERDUE | MEETING | PAYMENT_RECEIPT
  status      String // SENT | FAILED | TEST
  provider    String // DHIRAAGU | TEST
  providerRef String?
  error       String?
  batchId     String?
  memberId    String?
  member      Member?  @relation(fields: [memberId], references: [id], onDelete: SetNull)
  sentById    String?
  createdAt   DateTime @default(now())

  @@index([memberId, kind, createdAt])
}

// ─── Security ───────────────────────────────────────────────────────

/** Fixed-window counters for login throttling and public-form rate limits. */
model RateLimit {
  key     String   @id // e.g. "login:acct:someone@example.mv", "form:join:203.0.113.7"
  count   Int      @default(0)
  resetAt DateTime
}

/**
 * Sealed ballots waiting to be counted. The choices are encrypted, and they are
 * moved into ElectionVote in shuffled batches (in a separate transaction), so a
 * counted vote can't be linked back to the ElectionVoter row even with direct
 * database access.
 */
model ElectionPendingBallot {
  id         String @id @default(uuid())
  electionId String
  sealed     String // AES-256-GCM encrypted JSON of {positionId, candidateId}[]
}
