# Postgres. In production use Supabase:
#   DATABASE_URL → "Transaction pooler" string (port 6543) + "?pgbouncer=true&connection_limit=1"
#   DIRECT_URL   → "Session pooler" or direct string (port 5432)
DATABASE_URL="postgresql://mhpu:mhpu-dev@localhost:5433/mhpu"
DIRECT_URL="postgresql://mhpu:mhpu-dev@localhost:5433/mhpu"
# Long random string: openssl rand -base64 32
SESSION_SECRET="replace-with-a-long-random-string"
# Supabase Storage (production). Empty = store files on local disk (development).
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
